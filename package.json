{
	"name": "vite-plugin-iife",
	"version": "2.1.3",
	"description": "Vite plugin for simple IIFE-compiled script imports.",
	"keywords": [
		"vite-plugin",
		"iife",
		"vite",
		"import",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/vite-plugin-iife",
	"bugs": "https://github.com/kitschpatrol/vite-plugin-iife/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/vite-plugin-iife.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./ext": {
			"types": "./ext.d.ts"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"./ext.d.ts",
		"dist"
	],
	"scripts": {
		"build": "tsx ./scripts/build-plugin.ts && tsc -p tsconfig.plugin.json",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"pretty-bytes": "^7.2.0"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/node": "^20.19.41",
		"@vitest/browser-playwright": "^5.0.3",
		"bumpp": "^12.3.0",
		"esbuild": "^0.28.2",
		"playwright": "^1.63.0",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^7.3.3",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^20.19.0 || ^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
